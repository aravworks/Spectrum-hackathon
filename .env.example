# App
APP_ENV=development
APP_NAME=waste-platform
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
SECRET_KEY=replace-me
JWT_ISSUER=waste-platform
JWT_AUDIENCE=waste-platform-web

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/waste
REDIS_URL=redis://localhost:6379/0

# Object storage
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=waste-media
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
S3_REGION=auto

# Maps/GIS
MAP_PROVIDER=replace-me
MAPS_API_KEY=replace-me
GEOCODING_API_KEY=replace-me
ROUTING_API_URL=replace-me

# Satellite/GIS
SATELLITE_PROVIDER=replace-me
SATELLITE_API_KEY=replace-me

# Notifications
SMS_PROVIDER=replace-me
SMS_API_KEY=replace-me
EMAIL_PROVIDER=replace-me
EMAIL_API_KEY=replace-me

# Payments
PAYMENT_PROVIDER=replace-me
PAYMENT_API_KEY=replace-me
PAYMENT_WEBHOOK_SECRET=replace-me

# ML
MODEL_REGISTRY_URL=replace-me
MODEL_VERSION=baseline

# Monitoring
SENTRY_DSN=replace-me

# IMPORTANT:
# Never commit real secrets. Use a secret manager in staging/production.
